---
const { tags, all, blog_footer } = Astro.props;

// Normalize tags: frontmatter gives an array, getTags() gives an object {tag: count}
const normalizedTags = Array.isArray(tags)
    ? Object.fromEntries(tags.map((tag) => [tag, null]))
    : tags;
---

{all && <h3 class="tag-title">View posts by tag</h3>}
<div class={`${all && "tags"}`}>
    <!-- Filter by tags: -->
    {blog_footer && <>Tags: </>}
    {
        normalizedTags &&
        Object.entries(normalizedTags).map(([tag, count]) => (
            <>
                <a class="tag tags_title" href={`/tag/${tag}`}>
                    #{tag}{count !== null ? ` [${count}]` : ""}
                </a>
                {` `}
            </>
        ))
    }
</div>